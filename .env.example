# Скопируйте в .env и заполните. .env в git не попадает.

# Обязательно для стабильных сессий. Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ключ DeepSeek. Если пусто — ассистент работает на локальном fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=30
LLM_MAX_TOKENS=700

# Локальная русская модель Vosk для расшифровки встреч
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
MEETING_MAX_AUDIO_MB=30

# Пользователь, под которым открывается демо (автовход)
DEMO_USER=anna

# Cookie Secure включать только за HTTPS.
COOKIE_SECURE=0
SESSION_MAX_AGE=28800
RATE_LIMIT_PER_MINUTE=20

# 1 — показывать режим демо в /health
DEMO_MODE=1
