# Скопируйте в .env и заполните. .env в git не попадает.

# Обязательно для стабильных сессий. Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ключ DeepSeek. Если пусто — ассистент работает на локальном fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=30
LLM_MAX_TOKENS=700

# Публичный адрес стенда. Для QR с телефона укажите LAN-IP: http://192.168.1.10:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cookie Secure включать только за HTTPS.
COOKIE_SECURE=0
SESSION_MAX_AGE=28800
RATE_LIMIT_PER_MINUTE=20

# 1 — показывать режим демо в /health
DEMO_MODE=1
